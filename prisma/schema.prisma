// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  USER
  MANAGER
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditStatus {
  SUCCESS
  FAILED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  role            UserRole         @default(USER)
  phoneNumber     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  areas           Area[]           @relation("AreaCreatedBy")
  equipmentModels EquipmentModel[] @relation("EquipmentModelCreatedBy")
  equipment       Equipment[]      @relation("EquipmentCreatedBy")
  equipmentHistory EquipmentLocationHistory[] @relation("EquipmentHistoryChangedBy")
  auditLogs       AuditLog[]
}

enum EquipmentHistoryEvent {
  INITIAL
  LOCATION_CHANGED
  STATUS_CHANGED
  LOCATION_AND_STATUS_CHANGED
  DELETED
}

model AuditLog {
  id        String        @id @default(cuid())
  action    String
  module    String
  status    AuditStatus   @default(SUCCESS)
  severity  AuditSeverity @default(LOW)
  message   String?
  userAgent String?
  metadata  Json?
  userId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([severity])
  @@index([status])
  @@map("audit_logs")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum EquipmentType {
  FURNITURE
  ELECTRONICS
  APPLIANCE
  TOOL
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
  LOST
}

model Area {
  id               String      @id @default(uuid())
  roomName         String
  roomCode         String?
  externalBranchId String
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  createdBy        User        @relation("AreaCreatedBy", fields: [createdById], references: [id])

  @@index([externalBranchId])
  @@index([createdById])
  @@unique([externalBranchId, roomCode])
  @@map("areas")
}

model EquipmentModel {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        EquipmentType
  price       Decimal?      @db.Decimal(10, 2)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  createdBy   User          @relation("EquipmentModelCreatedBy", fields: [createdById], references: [id])
  equipment   Equipment[]

  @@index([createdById])
  @@index([type])
  @@map("equipment_models")
}

model Equipment {
  id               String          @id @default(uuid())
  qrCode           String          @unique
  sku              String?
  equipmentModelId String
  status           EquipmentStatus @default(AVAILABLE)
  areaId           String
  photoUrl         String?
  lastAreaAssigned String?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  equipmentModel   EquipmentModel  @relation(fields: [equipmentModelId], references: [id])
  createdBy        User            @relation("EquipmentCreatedBy", fields: [createdById], references: [id])
  locationHistory  EquipmentLocationHistory[]

  @@index([equipmentModelId])
  @@index([areaId])
  @@index([createdById])
  @@map("equipment")
}

model EquipmentLocationHistory {
  id          String                @id @default(cuid())
  equipmentId String
  areaId      String
  status      EquipmentStatus
  event       EquipmentHistoryEvent @default(LOCATION_AND_STATUS_CHANGED)
  changedById String?
  changedAt   DateTime              @default(now())
  equipment   Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  changedBy   User?                 @relation("EquipmentHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([changedAt])
  @@index([changedById])
  @@index([equipmentId, changedAt])
  @@map("equipment_location_history")
}
